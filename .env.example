# Copy to .env.local for local development. Leave the Supabase values empty
# to run the game without sign-in. See docs/SETUP.md.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Show the monthly prizes. Leave unset until the prize rules are cleared
# to run (docs/PRIZES.md). Points and referrals are recorded either way.
PRIZES_ENABLED=
